# Example .env (copy this file to .env or .dev.env and adjust the values)
# Notes:
# - Local development: copy to .dev.env (AppSettings/DbSettings read .dev.env by default).
# - Production: copy to .env and fill in sensitive values (passwords, keys) securely.
# - Boolean values: true/false

#########################
# General App Settings
#########################
# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL={{ cookiecutter.default_log_level }}
# Test mode (true/false)
TEST_MODE={{ cookiecutter.default_test_mode }}
# Enable profiler (true/false)
PROFILING_ENABLED={{ cookiecutter.default_profiling_enabled }}
# Application title used in OpenAPI/docs
APP_TITLE={{ cookiecutter.app_title }}
# Global API prefix for non-public routers
API_PREFIX={{ cookiecutter.api_prefix }}
# Auth mode used by diagnostics/runtime config
AUTH_MODE={{ cookiecutter.default_auth_mode }}
# Default CORS lists (comma-separated; leave blank to disable global CORS)
CORS_ALLOWED_ORIGINS={{ cookiecutter.default_cors_allowed_origins }}
CORS_ALLOW_METHODS={{ cookiecutter.default_cors_allow_methods }}
CORS_ALLOW_HEADERS={{ cookiecutter.default_cors_allow_headers }}
# Probe timeouts in seconds
DB_PROBE_TIMEOUT_SECONDS={{ cookiecutter.db_probe_timeout_seconds }}
S3_PROBE_TIMEOUT_SECONDS={{ cookiecutter.s3_probe_timeout_seconds }}

#########################
# Database (only required if DB_ENABLED=true)
#########################
# Enable DB (true/false)
DB_ENABLED={{ cookiecutter.db_enabled }}
# Database Host/IP
DB_IP={{ cookiecutter.db_host }}
# Port (e.g., 5432 for Postgres)
DB_PORT={{ cookiecutter.db_port }}
# Username
DB_USERNAME={{ cookiecutter.db_username }}
# Password
DB_PASSWORD={{ cookiecutter.db_password }}
# Database name
DB_DATABASE={{ cookiecutter.db_database }}
# DB Engine echo (true/false) - SQL Logging
DB_ENGINE_ECHO={{ cookiecutter.db_engine_echo }}
DB_AUTO_CREATE_TABLES={{ cookiecutter.db_auto_create_tables }}
DB_POOL_SIZE={{ cookiecutter.db_pool_size }}
DB_MAX_OVERFLOW={{ cookiecutter.db_max_overflow }}
DB_POOL_RECYCLE={{ cookiecutter.db_pool_recycle }}
DB_POOL_PRE_PING={{ cookiecutter.db_pool_pre_ping }}

#########################
# CORS (only for local demos)
#########################
# Example: DEMO_CORS_ORIGINS="http://localhost:3000" or "*"
DEMO_CORS_ORIGINS=

#########################
# Auth / JWT (Prefix: AUTH_)
#########################
# Mode: jwks | hs
AUTH_MODE={{ cookiecutter.default_auth_mode }}
AUTH_VALIDATE_SIGNATURE={{ cookiecutter.auth_validate_signature }}
AUTH_VERIFY_SIGNATURE={{ cookiecutter.auth_verify_signature }}
AUTH_VERIFY_EXP={{ cookiecutter.auth_verify_exp }}
AUTH_VERIFY_ISS={{ cookiecutter.auth_verify_iss }}
AUTH_VERIFY_AUD={{ cookiecutter.auth_verify_aud }}
AUTH_DISABLE_SSL_VERIFY={{ cookiecutter.auth_disable_ssl_verify }}
AUTH_CLOCK_SKEW_SECS={{ cookiecutter.auth_clock_skew_secs }}
# Optional: Issuer / Audience
AUTH_ISSUER=
AUTH_AUDIENCE=
# Algorithms (Comma-separated supported values, e.g., RS256,HS256)
AUTH_ALGORITHMS={{ cookiecutter.default_auth_algorithms }}
# JWKS URL (if MODE=jwks)
AUTH_JWKS_URL=
# HS Secret (if MODE=hs) — sensitive, never store in VCS
AUTH_HS_SECRET=

#########################
# Roles (Prefix: ROLE_)
#########################
ROLE_ACTIVE={{ cookiecutter.role_active }}
ROLE_PREFIX={{ cookiecutter.role_prefix }}
# Comma-separated role lists (Example: reader,editor)
ROLE_READ_ROLES={{ cookiecutter.role_read_roles }}
ROLE_WRITE_ROLES={{ cookiecutter.role_write_roles }}
ROLE_DELETE_ROLES={{ cookiecutter.role_delete_roles }}
ROLE_ADMIN_ROLES={{ cookiecutter.role_admin_roles }}
# Example hierarchy: admin>editor>reader,user
ROLE_HIERARCHY={{ cookiecutter.role_hierarchy }}

#########################
# Storage (S3 / Filesystem)
#########################
# STORAGE_BACKEND: s3 | filesystem
STORAGE_BACKEND={{ cookiecutter.default_storage_backend }}
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_SECURE={{ cookiecutter.s3_secure }}
S3_ADDRESSING_STYLE={{ cookiecutter.s3_addressing_style }}
S3_PREFIX=
# Local filesystem root (if STORAGE_BACKEND=filesystem)
FILESYSTEM_ROOT={{ cookiecutter.filesystem_root }}

#########################
# Optional file overrides
#########################
# Additional env files that can be loaded (comma-separated)
ENV_FILE=.env
APP_ENV_FILE=.env
AUTH_ENV_FILE=.env
ROLE_ENV_FILE=.env

#########################
# Developer tools / Examples
#########################
# For local token generation (dev only):
# SECRET_KEY is used in dev-helper scripts (not part of the production AUTH_* configuration)
SECRET_KEY={{ cookiecutter.dev_secret_key }}

# End of example environment file
