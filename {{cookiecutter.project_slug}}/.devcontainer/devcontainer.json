{
	"name": "{{ cookiecutter.project_slug }}",
	"dockerComposeFile": "docker-compose.yml",
	"service": "workspace",
	"workspaceFolder": "/workspace",
	"remoteUser": "developer",

	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "streetsidesoftware.code-spell-checker", "esbenp.prettier-vscode"]
		}
	},

	"features": {
		"ghcr.io/guiyomh/features/just:0": {},
		"ghcr.io/devcontainers/features/node:1": { "version": "{{ cookiecutter.devcontainer_node_version }}" }
	},

	"forwardPorts": [{{ cookiecutter.dev_port }}, {{ cookiecutter.db_port }}],
	"portsAttributes": {
		"{{ cookiecutter.db_port }}": {
			"label": "Postgres",
			"onAutoForward": "notify"
		}
	},

	"postCreateCommand": "sudo chown -R $(id -u):$(id -g) /home/developer/.npm && echo 'chown: OK' || echo 'chown: FAILED'; uv sync",
	"postStartCommand": "sudo chown -R $(id -u):$(id -g) /home/developer/.npm || true"
}
