# Example .env (copy this file to .env or .dev.env and adjust the values)
# Notes:
# - Local development: copy to .dev.env (AppSettings/DbSettings read .dev.env by default).
# - Production: copy to .env and fill in sensitive values (passwords, keys) securely.
# - Boolean values: true/false

#########################
# General App Settings
#########################
# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Test mode (true/false)
TEST_MODE=false
# Enable profiler (true/false)
PROFILING_ENABLED=false

#########################
# Database (only required if DB_ENABLED=true)
#########################
# Enable DB (true/false)
DB_ENABLED=false
# Database Host/IP
DB_IP=localhost
# Port (e.g., 5432 for Postgres)
DB_PORT=5432
# Username
DB_USERNAME=postgres
# Password
DB_PASSWORD=postgres
# Database name
DB_DATABASE=app_db
# DB Engine echo (true/false) - SQL Logging
DB_ENGINE_ECHO=false

#########################
# CORS (only for local demos)
#########################
# Example: DEMO_CORS_ORIGINS="http://localhost:3000" or "*"
DEMO_CORS_ORIGINS=

#########################
# Auth / JWT (Prefix: AUTH_)
#########################
# Mode: jwks | hs
AUTH_MODE=jwks
AUTH_VALIDATE_SIGNATURE=true
AUTH_VERIFY_SIGNATURE=true
AUTH_VERIFY_EXP=true
AUTH_VERIFY_ISS=true
AUTH_VERIFY_AUD=true
AUTH_DISABLE_SSL_VERIFY=false
AUTH_CLOCK_SKEW_SECS=60
# Optional: Issuer / Audience
AUTH_ISSUER=
AUTH_AUDIENCE=
# Algorithms (Comma-separated supported values, e.g., RS256,HS256)
AUTH_ALGORITHMS=RS256
# JWKS URL (if MODE=jwks)
AUTH_JWKS_URL=
# HS Secret (if MODE=hs) — sensitive, never store in VCS
AUTH_HS_SECRET=

#########################
# Roles (Prefix: ROLE_)
#########################
ROLE_ACTIVE=true
ROLE_PREFIX=
# Comma-separated role lists (Example: reader,editor)
ROLE_READ_ROLES=reader
ROLE_WRITE_ROLES=writer
ROLE_DELETE_ROLES=
ROLE_ADMIN_ROLES=admin
# Example hierarchy: admin>editor>reader,user
ROLE_HIERARCHY=admin>editor>reader,user

#########################
# Storage (S3 / Filesystem)
#########################
# STORAGE_BACKEND: s3 | filesystem
STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_SECURE=true
S3_ADDRESSING_STYLE=auto
S3_PREFIX=
# Local filesystem root (if STORAGE_BACKEND=filesystem)
FILESYSTEM_ROOT=/data

#########################
# Optional file overrides
#########################
# Additional env files that can be loaded (comma-separated)
ENV_FILE=.env
APP_ENV_FILE=.env
AUTH_ENV_FILE=.env
ROLE_ENV_FILE=.env

#########################
# Developer tools / Examples
#########################
# For local token generation (dev only):
# SECRET_KEY is used in dev-helper scripts (not part of the production AUTH_* configuration)
SECRET_KEY=devsecret

# End of example environment file
