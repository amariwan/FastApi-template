{
  "project_name": "FastAPI Cookiecutter App",
  "project_slug": "{{ cookiecutter.project_name|lower|replace(' ', '-')|replace('_', '-') }}",
  "package_name": "{{ cookiecutter.project_slug|replace('-', '_') }}",
  "project_description": "A FastAPI service scaffolded from the FastAPI Cookiecutter template.",
  "author_name": "Your Name",
  "python_version": "3.13",
  "app_title": "{{ cookiecutter.project_name }}",
  "default_host": "0.0.0.0",
  "dev_port": "5000",
  "prod_host": "0.0.0.0",
  "prod_port": "8000",
  "api_prefix": "/api",
  "default_log_level": ["INFO", "DEBUG", "WARNING", "ERROR"],
  "default_test_mode": ["false", "true"],
  "default_profiling_enabled": ["false", "true"],
  "default_cors_allowed_origins": "",
  "default_cors_allow_methods": "*",
  "default_cors_allow_headers": "*",
  "default_auth_mode": ["jwks", "hs"],
  "default_auth_algorithms": "RS256",
  "auth_validate_signature": ["true", "false"],
  "auth_verify_signature": ["true", "false"],
  "auth_verify_exp": ["true", "false"],
  "auth_verify_iss": ["true", "false"],
  "auth_verify_aud": ["true", "false"],
  "auth_disable_ssl_verify": ["false", "true"],
  "auth_clock_skew_secs": "60",
  "db_enabled": ["false", "true"],
  "db_host": "localhost",
  "db_port": "5432",
  "db_username": "postgres",
  "db_password": "postgres",
  "db_database": "{{ cookiecutter.package_name }}_db",
  "db_engine_echo": ["false", "true"],
  "db_auto_create_tables": ["false", "true"],
  "db_pool_size": "5",
  "db_max_overflow": "10",
  "db_pool_recycle": "1800",
  "db_pool_pre_ping": ["true", "false"],
  "db_probe_timeout_seconds": "2",
  "s3_probe_timeout_seconds": "2",
  "role_active": ["true", "false"],
  "role_prefix": "",
  "role_read_roles": "reader",
  "role_write_roles": "writer",
  "role_delete_roles": "",
  "role_admin_roles": "admin",
  "role_hierarchy": "admin>editor>reader,user",
  "default_storage_backend": ["s3", "filesystem"],
  "s3_secure": ["true", "false"],
  "s3_addressing_style": ["auto", "path", "virtual"],
  "filesystem_root": "/data",
  "dev_secret_key": "devsecret",
  "include_vscode": ["yes", "no"],
  "include_devcontainer": ["yes", "no"],
  "create_dotenv_file": ["yes", "no"],
  "devcontainer_node_version": "lts",
  "devcontainer_postgres_image": "postgres:16"
}
